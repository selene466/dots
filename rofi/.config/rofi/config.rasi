configuration {
    modi: ["drun", "window", "run"];
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    sidebar-mode: false;
    display-drun: " "; display-run: " ";
    display-window: " ";
}

@theme "./themes/tokyonight.rasi"
